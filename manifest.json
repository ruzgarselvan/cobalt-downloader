{
  "manifest_version": 3,
  "name": "Cobalt Downloader",
  "version": "0.1.0",
  "description": "Copy a video link, download it in one click via cobalt. Optional TorBox support for magnet links and file hosts.",
  "permissions": [
    "storage",
    "downloads",
    "offscreen",
    "clipboardRead",
    "scripting",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Download the video on this page"
  },
  "options_ui": {
    "page": "options.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
